# =============================================================================
# ETF Investment Application - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual keys/settings.

# FRED API Key - Register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Finnhub API Key - Register at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# IBKR Settings
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# App Settings
INITIAL_CAPITAL=100000
MONTHLY_CONTRIBUTION=10000
REBALANCE_DAY=1

# Hermes Agent Integration
# Webhook URL for your persistent Hermes Agent to receive daily reports and alerts.
HERMES_WEBHOOK_URL=http://your-hermes-agent-webhook-url/webhook

# Reddit retail-attention overlay (optional). Without these, the panel uses
# public RSS (no upvote counts, ~1 request/second, easy to 429). With a
# Reddit "script" app, set all five; app-only (client credentials) needs the
# first three. Create an app at https://www.reddit.com/prefs/apps.
# Never commit real values. Names only:
#   REDDIT_CLIENT_ID, REDDIT_CLIENT_SECRET, REDDIT_USER_AGENT,
#   REDDIT_USERNAME, REDDIT_PASSWORD
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fontesfund:retail-attention:v1 (research)
REDDIT_USERNAME=
REDDIT_PASSWORD=
