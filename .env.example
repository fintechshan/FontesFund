# =============================================================================
# ETF Investment Application - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual keys/settings.

# FRED API Key - Register at https://fred.stlouisfed.org/docs/api/api_key.html
# Never commit a real key.
FRED_API_KEY=your_fred_api_key_here

# First-release CPI/GDP clock (comparison path C, not the default).
# The default is path B: revised CPI and GDP with CPI+1 and GDP+4, VIX and
# SPY momentum lagged one month, plus the daily overlay in the backtest.
# Set this to 1 to rebuild data/backtest_results/vintage_release_yoy.csv and
# data/cache/vintage_*.csv.
# With a real FRED_API_KEY, the rebuild calls fredapi get_series_first_release,
# get_series_all_releases, and get_series_as_of_date for GDPC1, CPIAUCSL, and
# CPIAUCNS (not seasonally adjusted). python scripts/ab_vintage.py then adds
# the NSA row. Without a key, CPIAUCNS is skipped and the SA clock comes from
# Philadelphia Fed RTDSM (pcpiMvMd.xlsx, routputMvQd.xlsx).
# A failed refresh keeps the saved table. Do not shorten CPI+1 or GDP+4.
USE_REALTIME_VINTAGE=0

# Finnhub API Key - Register at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# IBKR Settings
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# App Settings
INITIAL_CAPITAL=100000
MONTHLY_CONTRIBUTION=10000
REBALANCE_DAY=1

# Hermes Agent Integration
# Webhook URL for your persistent Hermes Agent to receive daily reports and alerts.
HERMES_WEBHOOK_URL=http://your-hermes-agent-webhook-url/webhook

# Reddit retail-attention overlay (optional). Without these, the panel uses
# public RSS (no upvote counts, ~1 request/second, easy to 429). With a
# Reddit "script" app, set all five; app-only (client credentials) needs the
# first three. Create an app at https://www.reddit.com/prefs/apps.
# Never commit real values. Names only:
#   REDDIT_CLIENT_ID, REDDIT_CLIENT_SECRET, REDDIT_USER_AGENT,
#   REDDIT_USERNAME, REDDIT_PASSWORD
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=fontesfund:retail-attention:v1 (research)
REDDIT_USERNAME=
REDDIT_PASSWORD=
