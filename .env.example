# =============================================================================
# ETF Investment Application - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual keys/settings.

# FRED API Key - Register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Finnhub API Key - Register at https://finnhub.io/register
FINNHUB_API_KEY=your_finnhub_api_key_here

# IBKR Settings
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=

# App Settings
INITIAL_CAPITAL=100000
MONTHLY_CONTRIBUTION=10000
REBALANCE_DAY=1

# Hermes Agent Integration
# Webhook URL for your persistent Hermes Agent to receive daily reports and alerts.
HERMES_WEBHOOK_URL=http://your-hermes-agent-webhook-url/webhook

# -----------------------------------------------------------------------------
# Render (see docs/DEPLOY_RENDER.md). Do not commit real values.
# Set the same REFRESH_TOKEN on the Render service and as a GitHub Actions secret.
# -----------------------------------------------------------------------------
REFRESH_TOKEN=generate_a_long_random_string

# Leave unset on Render. Set only if you intentionally keep the legacy GCS bucket.
# GCS_BUCKET=

# 1 = do not spawn run_backtest.py at process start (Render Blueprint sets this).
DISABLE_STARTUP_REFRESH=0

# 0 = finance-lexicon sentiment, skip loading FinBERT (Render free/starter).
# 1 = try FinBERT (needs about 2 GB RAM).
FINBERT_ENABLED=1

# Public origin of the Render service, no path and no trailing slash.
# Used by the refresh GitHub Action, not by the Dash process.
# DASHBOARD_URL=https://fontesfund-dashboard.onrender.com
